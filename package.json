{
  "name": "openflightclaims",
  "version": "0.1.0",
  "private": true,
  "description": "Open community directory of official airline claim, refund, complaint, and passenger-rights links.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWConnoi/OpenFlightClaims.git"
  },
  "homepage": "https://openflightclaims.com",
  "bugs": {
    "url": "https://github.com/OWConnoi/OpenFlightClaims/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:data": "tsx scripts/validate-airline-data.ts",
    "validate:translations": "tsx scripts/validate-translations.ts",
    "verify:links": "tsx scripts/verify-airline-links.ts",
    "stamp:verified": "tsx scripts/stamp-verified-records.ts",
    "discover:airlines": "tsx scripts/discover-airline-links.ts",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm run validate:data && npm run validate:translations && npm run test && npm run verify:links && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.0",
    "cheerio": "^1.1.2",
    "framer-motion": "^12.40.0",
    "next": "^16.0.10",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
